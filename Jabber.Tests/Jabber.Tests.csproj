<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      What lies here belongs to the console - everything else has moved to
      Ratatoskr with the protocol. The RootNamespace therefore follows
      Ratatoskr, the AssemblyName stays independent: two suites with the same
      name would be the same file.
    -->
    <RootNamespace>org.GraphDefined.Vanaheimr.Ratatoskr.Tests</RootNamespace>
    <AssemblyName>org.GraphDefined.Vanaheimr.Ratatoskr.Jabber.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jabber\Jabber.csproj" />
  </ItemGroup>

</Project>
