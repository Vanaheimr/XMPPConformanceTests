<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      Was hier liegt, gehoert der Konsole - alles andere ist mit dem Protokoll
      nach Ratatoskr gezogen. Der RootNamespace folgt deshalb Ratatoskr, der
      AssemblyName bleibt eigenstaendig: Zwei Suiten mit demselben Namen waeren
      dieselbe Datei.
    -->
    <RootNamespace>org.GraphDefined.Vanaheimr.Ratatoskr.Tests</RootNamespace>
    <AssemblyName>org.GraphDefined.Vanaheimr.Ratatoskr.Jabber.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jabber\Jabber.csproj" />
  </ItemGroup>

</Project>
