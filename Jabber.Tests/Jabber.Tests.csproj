<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      RootNamespace bewusst wie in HermodTests: Der Inhalt von XMPP/ soll sich
      spaeter unveraendert nach HermodTests/XMPP/ kopieren lassen. Der
      AssemblyName bleibt eigenstaendig, damit beide Suiten nebeneinander
      existieren koennen.
    -->
    <RootNamespace>org.GraphDefined.Vanaheimr.Hermod.Tests</RootNamespace>
    <AssemblyName>org.GraphDefined.Vanaheimr.Hermod.XMPP.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jabber\Jabber.csproj" />
  </ItemGroup>

</Project>
