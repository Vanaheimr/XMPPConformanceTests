<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>org.GraphDefined.Vanaheimr.Ratatoskr</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Only the log of the output any more: the console writes itself and needs
      a logger for that. BouncyCastle stood here as long as OMEMO lay here -
      since D97 it does not any more, and a package nobody uses is a claim
      about a dependency that does not exist.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\libs\Ratatoskr\Ratatoskr\Ratatoskr.csproj" />
  </ItemGroup>

</Project>
