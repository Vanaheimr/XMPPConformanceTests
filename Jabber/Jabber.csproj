<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>org.GraphDefined.Vanaheimr.Hermod.XMPP</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.9" />

    <!--
      OMEMO (XEP-0384) braucht X25519 und Ed25519. Die BCL hat beides nicht -
      in System.Security.Cryptography.dll von .NET 10 kommt "X25519" kein
      einziges Mal vor -, und Kurvenarithmetik von Hand ist der eine Ort, an
      dem ein Fehler nicht auffaellt und alles kostet.

      Ausdruecklich aufgefuehrt, obwohl Hermod dasselbe Paket schon mitbringt:
      Wer eine transitive Abhaengigkeit direkt benutzt, verliert sie in dem
      Augenblick, in dem der Vorbesitzer sie ablegt.
    -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Der Testserver benutzt Hermods WebSocket-Server samt TLS, statt WebSocket-Framing selbst zu schreiben. -->
    <ProjectReference Include="..\libs\Hermod\Hermod\Hermod.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Zweiter Name fuer den Fall, dass die Tests spaeter nach HermodTests wandern. -->
    <InternalsVisibleTo Include="org.GraphDefined.Vanaheimr.Hermod.XMPP.Tests" />
    <InternalsVisibleTo Include="org.GraphDefined.Vanaheimr.Hermod.Tests" />
  </ItemGroup>

</Project>
