<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      What lies here is what needs a foreign implementation - Prosody,
      ejabberd, python-omemo - and nothing else: since E20 the console and its
      tests have a repository of their own. What is checked is Ratatoskr, so
      the RootNamespace follows it; the AssemblyName does not, for two suites
      with the same name would be the same file.
    -->
    <RootNamespace>org.GraphDefined.Vanaheimr.Ratatoskr.Tests</RootNamespace>
    <AssemblyName>org.GraphDefined.Vanaheimr.Ratatoskr.XMPPConformanceTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\libs\Ratatoskr\Ratatoskr\Ratatoskr.csproj" />
  </ItemGroup>

  <!--
    The oracle travels with the assembly. OmemoOracleTests used to look for
    omemo_oracle.py by walking upwards from the output directory, which holds
    only as long as the output lies inside the repository - and the run both
    setup scripts print does not: the artifacts path they pass to `dotnet test`
    (/tmp/conformance-artifacts) keeps the Linux build out of the Windows tree,
    and with it the walk found nothing and three tests went red saying the
    checkout was broken when it was not. Copied next to the assembly, the
    oracle is found wherever the output goes.

    `None Remove` first, because the SDK has already taken these files into
    `None` by its default glob and the same file may not arrive twice.
  -->
  <ItemGroup>
    <None Remove="XEPs\Oracle\**" />
    <Content Include="XEPs\Oracle\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
