<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      What lies here is what needs a foreign implementation - Prosody,
      ejabberd, python-omemo - and nothing else: since E20 the console and its
      tests have a repository of their own. What is checked is Ratatoskr, so
      the RootNamespace follows it; the AssemblyName does not, for two suites
      with the same name would be the same file.
    -->
    <RootNamespace>org.GraphDefined.Vanaheimr.Ratatoskr.Tests</RootNamespace>
    <AssemblyName>org.GraphDefined.Vanaheimr.Ratatoskr.XMPPConformanceTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\libs\Ratatoskr\Ratatoskr\Ratatoskr.csproj" />
  </ItemGroup>

</Project>
